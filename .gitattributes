# Kotlin template - Git attributes
# https://git-scm.com/docs/gitattributes

# Linguist: exclude template initializer from language stats
/init.sh -linguist-detectable

# Linguist: Gradle lock files are generated
flake.lock linguist-generated=true
gradle.lockfile linguist-generated=true
deps.json linguist-generated=true

# Kotlin source files
*.kt text linguist-language=Kotlin diff=kotlin
*.kts text linguist-language=Kotlin diff=kotlin
*.gradle.kts text linguist-language=Kotlin

# Normalize line endings to LF and auto-detect text files
* text=auto eol=lf

# Shell scripts must use LF
*.sh text eol=lf
*.bash text eol=lf

# Gradle wrapper batch scripts require CRLF (generated by Gradle)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Do not normalize patch/diff files
*.diff -text
*.patch -text
