{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "kotlin-ls": {
      "disabled": true
    },
    "kotlin-language-server": {
      "command": ["kotlin-language-server"],
      "extensions": [".kt", ".kts"]
    },
    "json-ls": {
      "command": ["vscode-json-languageserver", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "yaml-ls": {
      "command": ["yaml-language-server", "--stdio"]
    },
    "tombi": {
      "command": ["tombi", "lsp"],
      "extensions": [".toml"]
    },
    "nixd": {
      "command": ["nixd"]
    }
  }
}
